{
  "version": 2,
  "buildCommand": "python manage.py collectstatic --noinput",
  "installCommand": "pip install -r requirements.txt",
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1" },
    { "src": "/media/(.*)", "dest": "https://res.cloudinary.com/dogcpqocp/$1" },
    { "src": "/(.*)", "dest": "/" }
  ]
}
